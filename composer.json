{
    "name": "saluvera/saluvera",
    "description": "Sistema integral de gestion para profesionales de la salud",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "SALUVERA",
            "email": "contacto@saluvera.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/constants.php",
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"echo 'Autoloader generado correctamente';\""
        ]
    }
}
